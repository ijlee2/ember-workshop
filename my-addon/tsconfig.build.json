{
  "extends": "@ijlee2-frontend-configs/typescript/ember-addon",
  "compilerOptions": {
    "declarationDir": "declarations",
    "exactOptionalPropertyTypes": false,
    "plugins": [
      {
        "name": "@glint/tsserver-plugin"
      }
    ],
    "rootDir": "./src",
    "types": ["@glint/ember-tsc/types", "ember-source/types"]
  },
  "include": ["src/**/*"],
  "glint": {
    "additionalSpecialForms": {
      "globals": {
        "and": "&&",
        "eq": "===",
        "not": "!",
        "neq": "!==",
        "or": "||"
      }
    }
  }
}
