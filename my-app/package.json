{
  "name": "my-app",
  "version": "1.0.0",
  "private": true,
  "description": "An Ember app to illustrate core concepts in Ember (v6)",
  "keywords": [
    "ember",
    "emberjs",
    "ember-polaris",
    "ember-tutorial",
    "embroider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/ember-workshop.git"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build && ./post-build.sh",
    "build:test": "NODE_ENV=development vite build --config \"vite.test.config.mts\" --mode development",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --cache",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:intl": "ember-intl-lint",
    "lint:intl:fix": "ember-intl-lint --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prelint:types": "type-css-modules --src app",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "test": "pnpm build:test && ember-test --path dist",
    "test:watch": "concurrently \"pnpm build:test --watch\" \"ember-test --path dist --server\" --names build,test",
    "test:watch-vite": "NODE_ENV=development vite build --mode development --watch"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@ember-intl/lint": "^2.0.3",
    "@ember-intl/vite": "^2.0.3",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.25",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.1",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.13",
    "@faker-js/faker": "^10.6.0",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.11.4",
    "@glint/template": "^1.9.0",
    "@glint/tsserver-plugin": "^2.7.7",
    "@ijlee2-frontend-configs/eslint-config-ember": "^4.3.0",
    "@ijlee2-frontend-configs/prettier": "^3.4.0",
    "@ijlee2-frontend-configs/stylelint": "^3.2.3",
    "@ijlee2-frontend-configs/typescript": "^4.1.0",
    "@nullvoxpopuli/ember-composable-helpers": "^5.3.2",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.14",
    "@types/sinon": "^22.0.0",
    "axe-core": "^4.13.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^10.0.5",
    "decorator-transforms": "^2.4.0",
    "ember-a11y-refocus": "^5.2.1",
    "ember-a11y-testing": "^8.0.1",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~7.2.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-concurrency": "^5.2.1",
    "ember-container-query": "^7.1.4",
    "ember-intl": "^9.1.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.2.0",
    "ember-test": "workspace:*",
    "embroider-css-modules": "^4.1.3",
    "eslint": "^10.11.0",
    "miragejs": "^0.1.48",
    "my-addon": "workspace:*",
    "prettier": "^3.9.8",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "sinon": "^22.1.0",
    "strip-test-selectors": "^0.1.0",
    "stylelint": "^17.15.0",
    "type-css-modules": "^3.2.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  }
}
